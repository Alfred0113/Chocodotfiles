#!/bin/bash
# Selecciona un wallpaper (de ~/Imágenes/Wallpapers), lo pone de fondo con
# swaybg, y genera theming/current/colors.toml a partir de esa imagen usando
# matugen o wallust.
#
# Uso:
#   chocomazapan-wallpaper-set                       -> selector interactivo con miniaturas
#                                                        (Return = matugen, Ctrl+Return = wallust)
#   chocomazapan-wallpaper-set random [motor]         -> imagen al azar
#   chocomazapan-wallpaper-set <archivo|nombre> [motor]

set -euo pipefail

WALLPAPER_DIR="$HOME/Imágenes/Wallpapers"
CURRENT_DIR="$HOME/dotfiles/theming/current"
ENGINE_STATE_FILE="$CURRENT_DIR/engine"

mkdir -p "$CURRENT_DIR"

image_arg="${1:-}"
engine_arg="${2:-}"

list_images() {
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \)
}

pick_random_image() {
    list_images | shuf -n1
}

# Sin argumentos: delega en el menú "wallpapers" de Walker (elephant-menus,
# ~/dotfiles/walker/menus/wallpapers.lua), que muestra miniatura real por
# imagen y preview grande. Return -> matugen, Ctrl+Return -> wallust. Cada
# entrada llama de vuelta a este mismo script con imagen+motor explícitos
# (rama no interactiva de abajo), así que aquí solo hace falta abrir el menú.
if [ -z "$image_arg" ]; then
    chocomazapan-launch-walker -m menus:wallpapers --width 800 --minheight 400
    exit 0
fi

# Resolver imagen.
if [ "$image_arg" = "random" ] || [ "$image_arg" = "--random" ]; then
    image="$(pick_random_image)"
else
    if [ -f "$image_arg" ]; then
        image="$image_arg"
    else
        image="$WALLPAPER_DIR/$image_arg"
    fi
fi

if [ ! -f "$image" ]; then
    echo "Imagen no encontrada: $image" >&2
    exit 1
fi

# Resolver motor.
if [ -n "$engine_arg" ]; then
    engine="$engine_arg"
elif [ -f "$ENGINE_STATE_FILE" ]; then
    engine="$(cat "$ENGINE_STATE_FILE")"
else
    engine="matugen"
fi

if [ "$engine" != "matugen" ] && [ "$engine" != "wallust" ]; then
    echo "Motor inválido: $engine (usa matugen o wallust)" >&2
    exit 1
fi

# Poner el wallpaper.
pkill -x swaybg 2>/dev/null || true
sleep 0.2
setsid swaybg -i "$image" -m fill >/dev/null 2>&1 &
disown

# Generar la paleta desde la imagen.
case "$engine" in
    matugen)
        matugen image "$image" --mode dark --prefer saturation
        ;;
    wallust)
        wallust run "$image"
        ;;
esac

ln -sfn "$image" "$CURRENT_DIR/wallpaper"
echo "$engine" > "$ENGINE_STATE_FILE"

# Generar waybar.css / walker.css / mako a partir de colors.toml.
"$HOME/dotfiles/bin/chocomazapan-apply-theme"

# Recargar apps para que tomen el nuevo tema.
if pidof waybar >/dev/null; then
    pkill -x waybar 2>/dev/null || true
    sleep 0.2
    setsid uwsm-app -- waybar >/dev/null 2>&1 &
    disown
fi

if pidof mako >/dev/null; then
    makoctl reload >/dev/null 2>&1 || true
fi

if pidof walker >/dev/null; then
    pkill -x walker 2>/dev/null || true
    sleep 0.2
    setsid uwsm-app -- env GSK_RENDERER=cairo walker --gapplication-service >/dev/null 2>&1 &
    disown
fi

if pidof swayosd-server >/dev/null; then
    "$HOME/dotfiles/bin/chocomazapan-restart-swayosd" >/dev/null 2>&1 || true
fi

"$HOME/dotfiles/bin/chocomazapan-theme-set-browser" >/dev/null 2>&1 || true
"$HOME/dotfiles/bin/chocomazapan-rgb-sync" >/dev/null 2>&1 || true
"$HOME/dotfiles/bin/chocomazapan-obsidian-sync" >/dev/null 2>&1 || true
"$HOME/dotfiles/bin/chocomazapan-screensaver-art" >/dev/null 2>&1 || true

echo "Wallpaper: $(basename "$image")"
echo "Motor: $engine"
