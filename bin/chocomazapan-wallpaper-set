#!/bin/bash
# Selecciona un wallpaper y genera theming/current/colors.toml a partir de
# esa imagen usando aether (bjarneo/aether, headless — nunca abre su GUI).
#
# Uso:
#   chocomazapan-wallpaper-set                        -> carrusel visual (QuickShell,
#                                                         chocomazapan-menu-images): tarjetas
#                                                         con miniatura real, la seleccionada
#                                                         se expande al centro. Navegar (flechas)
#                                                         no dispara nada; Return o click en la
#                                                         tarjeta expandida aplica.
#   chocomazapan-wallpaper-set random [modo]          -> headless, imagen al azar
#   chocomazapan-wallpaper-set <archivo|nombre> [modo] -> headless
#
# [modo] es un modo de extracción de aether (aether --list-modes). Por
# defecto "colorful" (paleta vibrante en OKLCH).

set -euo pipefail

WALLPAPER_DIR="$HOME/Imágenes/Wallpapers"
CURRENT_DIR="$HOME/dotfiles/theming/current"
MODE_STATE_FILE="$CURRENT_DIR/extract-mode"

mkdir -p "$CURRENT_DIR"

image_arg="${1:-}"
mode_arg="${2:-}"

list_images() {
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \)
}

pick_random_image() {
    list_images | shuf -n1
}

# Aplica el wallpaper real (awww) y sincroniza el resto del setup a partir
# de lo que ya haya en theming/current/colors.toml.
#
# Se usa awww (sucesor de swww) en vez de swaybg: swaybg tiene un bug real
# confirmado en este setup con dos monitores (mata+relanza el proceso en
# cada cambio, y a veces solo repinta uno de los dos outputs con la imagen
# nueva — mismo PID dueño de ambas capas, pero una se queda con pixeles
# viejos). awww corre como daemon persistente y solo recibe un comando
# nuevo por cambio, sin ese problema.
sync_desktop() {
    local image="$1" mode="$2"

    pgrep -x awww-daemon >/dev/null || {
        setsid uwsm-app -- awww-daemon >/dev/null 2>&1 &
        disown
    }

    # Espera a que el daemon esté realmente listo (socket abierto y outputs
    # ya registrados) antes de mandarle la imagen. En el arranque de sesión
    # el compositor todavía está levantando los monitores y arrancando el
    # resto del autostart, así que el "sleep 0.3" fijo de antes casi nunca
    # alcanzaba: `awww img` fallaba en silencio (2>&1 >/dev/null) y el
    # wallpaper se quedaba igual aunque los colores del tema sí se aplicaran.
    for _ in $(seq 1 100); do
        awww query >/dev/null 2>&1 && break
        sleep 0.1
    done

    # Reintenta el img por si el primer intento cae justo en la ventana en
    # la que el daemon responde query pero todavía no pinta.
    for _ in 1 2 3 4 5; do
        awww img "$image" --resize crop >/dev/null 2>&1 && break
        sleep 0.3
    done

    ln -sfn "$image" "$CURRENT_DIR/wallpaper"
    echo "$mode" >"$MODE_STATE_FILE"

    "$HOME/dotfiles/bin/chocomazapan-apply-theme"

    # Recarga Hyprland para que tome los bordes de ventana nuevos
    # (theming/current/hyprland-colors.lua).
    hyprctl reload >/dev/null 2>&1 || true

    if pidof waybar >/dev/null; then
        pkill -x waybar 2>/dev/null || true
        sleep 0.2
        setsid uwsm-app -- waybar >/dev/null 2>&1 &
        disown
    fi

    if pidof mako >/dev/null; then
        makoctl reload >/dev/null 2>&1 || true
    fi

    if pidof walker >/dev/null; then
        pkill -x walker 2>/dev/null || true
        sleep 0.2
        setsid uwsm-app -- env GSK_RENDERER=cairo walker --gapplication-service >/dev/null 2>&1 &
        disown
    fi

    if pidof swayosd-server >/dev/null; then
        "$HOME/dotfiles/bin/chocomazapan-restart-swayosd" >/dev/null 2>&1 || true
    fi

    "$HOME/dotfiles/bin/chocomazapan-theme-set-browser" >/dev/null 2>&1 || true
    "$HOME/dotfiles/bin/chocomazapan-icon-theme-sync" >/dev/null 2>&1 || true
    "$HOME/dotfiles/bin/chocomazapan-rgb-sync" >/dev/null 2>&1 || true
    "$HOME/dotfiles/bin/chocomazapan-obsidian-sync" >/dev/null 2>&1 || true
    "$HOME/dotfiles/bin/chocomazapan-screensaver-art" >/dev/null 2>&1 || true

    echo "Wallpaper: $(basename "$image")"
    echo "Modo: $mode"
}

if [ -z "$image_arg" ]; then
    # Interactivo: chocomazapan-menu-images (carrusel QuickShell). Bloquea
    # hasta que el usuario aplica una imagen (Return / click) o cancela
    # (Esc / click fuera) — navegar solo no dispara nada. Dentro del
    # selector: R = saltar a una imagen al azar (sin aplicar todavía),
    # M / Shift+M = cambiar el modo de extracción de aether.
    current_mode="colorful"
    [ -f "$MODE_STATE_FILE" ] && current_mode="$(cat "$MODE_STATE_FILE")"

    selection="$(chocomazapan-menu-images \
        --selected "$CURRENT_DIR/wallpaper" \
        --mode "$current_mode" \
        --colors-file "$CURRENT_DIR/quickshell-colors.json" \
        "$WALLPAPER_DIR")"
    [ -n "$selection" ] || exit 0
    image_arg="${selection%%$'\t'*}"
    mode_arg="${selection#*$'\t'}"
fi

# Headless: resolver imagen.
if [ "$image_arg" = "random" ] || [ "$image_arg" = "--random" ]; then
    image="$(pick_random_image)"
else
    if [ -f "$image_arg" ]; then
        image="$image_arg"
    else
        image="$WALLPAPER_DIR/$image_arg"
    fi
fi

if [ ! -f "$image" ]; then
    echo "Imagen no encontrada: $image" >&2
    exit 1
fi

if [ -n "$mode_arg" ]; then
    mode="$mode_arg"
elif [ -f "$MODE_STATE_FILE" ]; then
    mode="$(cat "$MODE_STATE_FILE")"
else
    mode="colorful"
fi

aether --generate "$image" --extract-mode "$mode" --no-apply --output "$CURRENT_DIR"

# aether escribe un vencord.theme.css que no usamos (Vencord carga
# vencord-quickcss.css, generado por chocomazapan-apply-theme) y que trae un
# @import a una URL externa ajena. Se descarta de las dos rutas donde aether
# lo deja para que no quede rastro.
rm -f "$CURRENT_DIR/vencord.theme.css" "$HOME/.config/aether/theme/vencord.theme.css"

sync_desktop "$image" "$mode"

chocomazapan-notification-send "Tema aplicado" "$(basename "$image") · $mode" >/dev/null 2>&1 || true
