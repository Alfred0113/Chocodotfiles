#!/bin/bash

# meta:summary=Toggle the calendar popup (QuickShell, bound to waybar's calendar icon)

if pgrep -f "quickshell.*calendar-popup.qml" >/dev/null; then
    pkill -f "quickshell.*calendar-popup.qml"
else
    setsid uwsm-app -- quickshell -p "$HOME/dotfiles/quickshell/calendar-popup.qml" >/dev/null 2>&1 &
    disown
fi
