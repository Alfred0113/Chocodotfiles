#!/bin/bash
# ChocoMazapan menu — trimmed down to what's actually used day to day.
# Deliberately drops the huge install/remove/update software catalog
# (that's just `paru`/`pacman` directly), Learn links, and laptop-only
# hardware toggles (hybrid GPU, touchpad haptics, etc).

BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"
  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  echo -e "$options" | chocomazapan-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" 2>/dev/null
}

# Screenshot / screen recording / color picker.
show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰃉  Color") in
  *Screenshot*) chocomazapan-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) show_main_menu ;;
  esac
}

show_screenrecord_menu() {
  chocomazapan-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio") in
  *"With no audio") chocomazapan-capture-screenrecording ;;
  *"With desktop audio") chocomazapan-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") chocomazapan-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *) back_to show_capture_menu ;;
  esac
}

# Quick on/off switches: idle-lock, notification do-not-disturb, and RGB sync.
show_toggle_menu() {
  case $(menu "Toggle" "󱫖  Idle Lock\n󰂛  Notifications\n󰖔  Nightlight\n󰐊  RGB Sync\n󰍜  Top bar\n󰘖  Window gaps\n󰨤  Square aspect") in
  *Idle*) chocomazapan-toggle-idle ;;
  *Notifications*) chocomazapan-toggle-notification-silencing ;;
  *Nightlight*) chocomazapan-toggle-nightlight ;;
  *RGB*) chocomazapan-toggle-rgb-sync ;;
  *"Top bar"*) chocomazapan-toggle-waybar ;;
  *"Window gaps"*) chocomazapan-hyprland-window-gaps-toggle ;;
  *"Square aspect"*) chocomazapan-hyprland-window-single-square-aspect-toggle ;;
  *) back_to show_main_menu ;;
  esac
}

# Hardware/service quick-launchers: audio mixer, wifi, bluetooth, plus
# restarting the background daemons (waybar, mako, walker, hypridle) if one
# gets into a bad state.
show_setup_menu() {
  case $(menu "Setup" "  Audio\n  Wifi\n󰂯  Bluetooth\n  Restart services\n󰮕  Crear snapshot") in
  *Audio*) chocomazapan-launch-audio ;;
  *Wifi*) chocomazapan-launch-wifi ;;
  *Bluetooth*) chocomazapan-launch-bluetooth ;;
  *snapshot*) chocomazapan-snapshot-create ;;
  *Restart*) show_restart_menu ;;
  *) show_main_menu ;;
  esac
}

show_restart_menu() {
  case $(menu "Restart" "  Hypridle\n󰎟  Mako\n󰍝  SwayOSD\n󰌧  Walker\n󰍜  Waybar") in
  *Hypridle*) chocomazapan-restart-hypridle ;;
  *Mako*) chocomazapan-restart-mako ;;
  *SwayOSD*) chocomazapan-restart-swayosd ;;
  *Walker*) chocomazapan-restart-walker ;;
  *Waybar*) chocomazapan-restart-waybar ;;
  *) back_to show_setup_menu ;;
  esac
}

# Wallpaper picker — this is the whole "theme" now (see chocomazapan-wallpaper-set):
# choosing an image also regenerates the color palette for waybar/mako/walker.
show_style_menu() {
  case $(menu "Style" "  Wallpaper") in
  *Wallpaper*) chocomazapan-wallpaper-set ;;
  *) show_main_menu ;;
  esac
}

# Session/power actions.
show_system_menu() {
  # Hibernar solo si el kernel la ofrece (swap + resume= configurados). En el
  # desktop con NVIDIA hace falta la config de system/hibernate/ (install.sh);
  # en la T14 (AMD) funciona sola.
  local items="  Lock
󰒲  Suspend"
  grep -qw disk /sys/power/state && items="$items
󰤄  Hibernar"
  items="$items
󰍃  Logout
󰜉  Restart
󰐥  Shutdown"

  case $(menu "System" "$items") in
  *Lock*) chocomazapan-system-lock ;;
  *Suspend*) systemctl suspend ;;
  *Hibernar*) systemctl hibernate ;;
  *Logout*) chocomazapan-system-logout ;;
  *Restart*) chocomazapan-system-reboot ;;
  *Shutdown*) chocomazapan-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n  Capture\n󰔎  Toggle\n  Setup\n  Style\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *screenrecord*) show_screenrecord_menu ;;
  *capture*) show_capture_menu ;;
  *toggle*) show_toggle_menu ;;
  *setup*) show_setup_menu ;;
  *style*) show_style_menu ;;
  *system*) show_system_menu ;;
  esac
}

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
