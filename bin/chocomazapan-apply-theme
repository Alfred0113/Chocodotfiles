#!/usr/bin/env python3
"""Genera los archivos de tema por app a partir de theming/current/colors.toml.

Lee ~/dotfiles/theming/current/colors.toml (generado por aether --generate)
y sustituye {{clave}} en cada plantilla de ~/dotfiles/theming/templates/,
escribiendo el resultado en ~/dotfiles/theming/current/<nombre-sin-.template>.
"""

import re
import sys
import tomllib
from pathlib import Path

DOTFILES = Path.home() / "dotfiles"
COLORS_FILE = DOTFILES / "theming" / "current" / "colors.toml"
TEMPLATES_DIR = DOTFILES / "theming" / "templates"
OUTPUT_DIR = DOTFILES / "theming" / "current"

PLACEHOLDER_RE = re.compile(r"\{\{(\w+)\}\}")


def main() -> int:
    if not COLORS_FILE.exists():
        print(f"No existe {COLORS_FILE}. Corre chocomazapan-wallpaper-set primero.", file=sys.stderr)
        return 1

    colors = tomllib.loads(COLORS_FILE.read_text())

    for template_path in sorted(TEMPLATES_DIR.glob("*.template")):
        text = template_path.read_text()

        def replace(match: re.Match) -> str:
            key = match.group(1)
            if key not in colors:
                raise KeyError(f"{template_path.name}: '{key}' no está en {COLORS_FILE.name}")
            return str(colors[key])

        rendered = PLACEHOLDER_RE.sub(replace, text)

        output_path = OUTPUT_DIR / template_path.stem
        output_path.write_text(rendered)
        print(f"Generado: {output_path}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
