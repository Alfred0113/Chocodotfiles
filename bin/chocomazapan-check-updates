#!/bin/bash
# Sincroniza el conteo de actualizaciones pendientes de pacman una vez y lo
# cachea en disco. Pensado para ejecutarse solo al iniciar sesión de Hyprland
# (ver hypr/autostart.lua), no en cada apertura de terminal: checkupdates
# sincroniza contra los mirrors por red y puede tardar segundos.
#
# El módulo "Update" de fastfetch (theming/current/fastfetch-config.jsonc)
# lee este archivo en vez de llamar a checkupdates directamente.

set -euo pipefail

CACHE_DIR="$HOME/.cache/chocomazapan"
CACHE_FILE="$CACHE_DIR/updates-pending"

mkdir -p "$CACHE_DIR"

count=$(checkupdates 2>/dev/null | wc -l) || true
echo "$count pending" > "$CACHE_FILE"
