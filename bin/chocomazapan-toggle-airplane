#!/bin/bash

# meta:summary=Toggle airplane mode: block/unblock all radios (wifi, bluetooth) via rfkill.

if rfkill list 2>/dev/null | grep -qE "Soft blocked: no"; then
  rfkill block all
  msg="Modo avión activado"
  icon="airplane-mode-symbolic"
else
  rfkill unblock all
  msg="Modo avión desactivado"
  icon="network-wireless-signal-excellent-symbolic"
fi

chocomazapan-swayosd-client --custom-message "$msg" --custom-icon "$icon" 2>/dev/null \
  || notify-send -u low "$msg"
