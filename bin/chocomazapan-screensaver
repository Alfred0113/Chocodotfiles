#!/bin/bash
# meta:summary=Run the ChocoMazapan screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.chocomazapan.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x tte 2>/dev/null
  pkill -f org.chocomazapan.screensaver 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

# Sync background with the current wallpaper-generated theme (falls back to black).
theme_bg=$(grep -m1 '^background' "$HOME/dotfiles/theming/current/colors.toml" 2>/dev/null | sed -E 's/.*"#?([0-9a-fA-F]{6})".*/\1/')
[[ $theme_bg =~ ^[0-9a-fA-F]{6}$ ]] || theme_bg="000000"
printf '\033]11;rgb:%s/%s/%s\007' "${theme_bg:0:2}" "${theme_bg:2:2}" "${theme_bg:4:2}"

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

while true; do
  art="$HOME/dotfiles/theming/current/screensaver.txt"
  [[ -f $art ]] || art="$HOME/dotfiles/bin/assets/screensaver.txt"
  tte -i "$art" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --existing-color-handling always \
    --random-effect --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
