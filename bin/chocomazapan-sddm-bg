#!/bin/bash
# meta:summary=Pick random wallpapers, blur+darken them, put them under the SDDM theme
# meta:group=system
#
# Corre como el usuario 'alfredo' (via chocomazapan-sddm-bg.service, Before=sddm)
# y deja N variantes en /usr/share/sddm/themes/chocomazapan/backgrounds/
# (current-0.jpg .. current-3.jpg + current.jpg = fallback). El tema QML elige
# una distinta por monitor. Ese dir lo hace escribible install.sh con chown.
# El desenfoque/oscurecido viene horneado (equivale a los blur_passes=2 /
# brightness=0.75 de hyprlock.conf).

set -u

BG_DIR="$HOME/Imágenes/Wallpapers"
CACHE_FILE="$HOME/dotfiles/theming/current/sddm-bg-cache"
OUT_DIR="/usr/share/sddm/themes/chocomazapan/backgrounds"
VARIANTS=4
MIN_W=1920
MIN_H=1080

mkdir -p "$(dirname "$CACHE_FILE")"

find_imgs() {
    find "$BG_DIR" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) "$@"
}
dir_signature() { find_imgs -printf '%f %s\n' 2>/dev/null | sort | md5sum; }

rebuild_cache() {
    : > "$CACHE_FILE"
    while IFS= read -r -d '' file; do
        dims=$(magick identify -format '%w %h\n' "$file" 2>/dev/null | head -n1) || continue
        w=${dims% *}; h=${dims#* }
        [ "${w:-0}" -ge "$MIN_W" ] && [ "${h:-0}" -ge "$MIN_H" ] && printf '%s\n' "$file" >> "$CACHE_FILE"
    done < <(find_imgs -print0 2>/dev/null)
    dir_signature > "$CACHE_FILE.sig"
}

current_sig="$(dir_signature)"
[ -f "$CACHE_FILE" ] && [ "$current_sig" = "$(cat "$CACHE_FILE.sig" 2>/dev/null)" ] || rebuild_cache

# Lista barajada de candidatos (distintos mientras alcancen; luego cicla).
if [ -s "$CACHE_FILE" ]; then
    mapfile -t pool < <(shuf "$CACHE_FILE")
else
    mapfile -t pool < <(find_imgs 2>/dev/null)
fi
[ "${#pool[@]}" -gt 0 ] || { echo "chocomazapan-sddm-bg: no hay wallpapers en $BG_DIR" >&2; exit 0; }

[ -w "$OUT_DIR" ] || { echo "chocomazapan-sddm-bg: $OUT_DIR no escribible (corre install.sh)" >&2; exit 0; }

process() {  # $1 = origen, $2 = destino
    local tmp; tmp="$(mktemp --suffix=.jpg)"
    if magick "$1" -auto-orient -resize 1920x1080^ -gravity center -extent 1920x1080 \
           -blur 0x8 -modulate 72 -quality 88 "$tmp" 2>/dev/null; then
        mv -f "$tmp" "$2"; chmod 644 "$2"
    else
        rm -f "$tmp"; echo "chocomazapan-sddm-bg: magick fallo con $1" >&2; return 1
    fi
}

rc=0
for i in $(seq 0 $((VARIANTS - 1))); do
    src="${pool[$((i % ${#pool[@]}))]}"
    process "$src" "$OUT_DIR/current-$i.jpg" || rc=1
done
# current.jpg = fallback (lo usa el tema si no puede resolver el indice de monitor)
cp -f "$OUT_DIR/current-0.jpg" "$OUT_DIR/current.jpg" 2>/dev/null || true
exit $rc
