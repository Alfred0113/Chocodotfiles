#!/bin/bash

# meta:summary=Launch or focus on a given web app identified by the window-pattern.
# meta:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: chocomazapan-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="chocomazapan-launch-webapp $@"

exec chocomazapan-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
