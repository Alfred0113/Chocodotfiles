#!/bin/bash

# meta:summary=Returns a formatted battery status string with percentage and power draw/charge.

bat=$(upower -e 2>/dev/null | grep -m1 BAT)
if [[ -z $bat ]]; then
    echo "Sin batería (equipo de escritorio)"
    exit 0
fi

battery_info=$(upower -i "$bat")

percentage=$(echo "$battery_info" | awk '/percentage/ {
    print int($2)
    exit
}')

power_rate=$(echo "$battery_info" | awk '/energy-rate/ {
    rounded = sprintf("%.1f", $2)
    sub(/\.0$/, "", rounded)
    print rounded
    exit
}')

state=$(echo "$battery_info" | awk '/state/ { print $2; exit }')
time_remaining=$(chocomazapan-battery-remaining-time)
capacity=$(chocomazapan-battery-capacity)

if [[ $state == "charging" ]]; then
    echo "Battery ${percentage}%  ·  ${time_remaining} to full  ·   ${power_rate}W / ${capacity}Wh"
else
    echo "Battery ${percentage}%  ·  ${time_remaining} left  ·   ${power_rate}W / ${capacity}Wh"
fi
