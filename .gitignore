theming/current/

# Flag de runtime del toggle de formato del reloj de waybar.
waybar/.clock-alt

# Fondo generado del tema SDDM (imagen personal, la genera chocomazapan-sddm-bg).
sddm/themes/chocomazapan/backgrounds/current*.jpg
